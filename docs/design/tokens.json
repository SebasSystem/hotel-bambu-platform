{
  "$schema-note": "Design tokens v1.0 for Hotel Bambú Plaza, ported from the approved mockup (docs/design/mockup-design-spec.md §1). Source for the Tailwind CSS v4 @theme in apps/web/styles/tokens.css (guarded by styles/tokens.test.ts). Keys map to CSS variables: color.green-900 -> --color-green-900, semantic.* -> shadcn/ui variables. Contrast fixes vs the mockup: ink-muted #5F6862 (was #6D756F, 4.4:1 on ivory) and a green/gold focus ring (was gold on ivory, 2.1:1).",
  "color": {
    "green": "#315C45",
    "green-900": "#183B2C",
    "green-50": "#E2EADF",
    "sage": "#A8BEA0",
    "ivory": "#F8F6F0",
    "paper": "#FFFDF8",
    "sand": "#E8DDC7",
    "charcoal": "#26312B",
    "gold": "#C8A66A",
    "ink-muted": "#5F6862",
    "ink-muted-strong": "#56625A",
    "line": "rgba(38, 49, 43, 0.14)",
    "line-strong": "#AEB7B0",
    "on-dark-muted": "#D4DDCE",
    "notice-bg": "#EDF3EA",
    "notice-fg": "#365441",
    "warn-bg": "#FFF2D9",
    "warn-fg": "#7C5917",
    "neutral-bg": "#ECECEA",
    "neutral-fg": "#656B67",
    "danger": "#A23838",
    "promo": "#A8582F",
    "whatsapp": "#246F49",
    "admin-bg": "#F3F2ED",
    "white": "#FFFFFF"
  },
  "semantic": {
    "background": "{color.ivory}",
    "foreground": "{color.charcoal}",
    "card": "{color.paper}",
    "card-foreground": "{color.charcoal}",
    "popover": "{color.white}",
    "popover-foreground": "{color.charcoal}",
    "primary": "{color.green}",
    "primary-foreground": "{color.white}",
    "primary-hover": "{color.green-900}",
    "secondary": "{color.sand}",
    "secondary-foreground": "{color.charcoal}",
    "muted": "{color.sand}",
    "muted-foreground": "{color.ink-muted}",
    "accent": "{color.green-50}",
    "accent-foreground": "{color.green-900}",
    "accent-decorative": "{color.gold}",
    "destructive": "{color.danger}",
    "destructive-foreground": "{color.white}",
    "border": "{color.line}",
    "input": "{color.line-strong}",
    "ring": "{color.green}",
    "ring-on-dark": "{color.gold}",
    "surface-dark": "{color.green-900}",
    "on-surface-dark": "{color.ivory}",
    "on-surface-dark-muted": "{color.sage}",
    "promo-foreground": "{color.white}",
    "whatsapp-foreground": "{color.white}"
  },
  "contrast": {
    "$note": "WCAG 2.2 pairs checked by styles/tokens.test.ts: text >= 4.5, large text and non-text (focus ring, borders that carry meaning) >= 3.",
    "text": [
      ["charcoal", "ivory"],
      ["charcoal", "paper"],
      ["charcoal", "sand"],
      ["ink-muted", "ivory"],
      ["ink-muted", "paper"],
      ["ink-muted", "white"],
      ["ink-muted-strong", "sand"],
      ["green", "ivory"],
      ["green", "paper"],
      ["green", "sand"],
      ["white", "green"],
      ["white", "charcoal"],
      ["white", "whatsapp"],
      ["ivory", "charcoal"],
      ["ivory", "green-900"],
      ["sage", "green-900"],
      ["notice-fg", "notice-bg"],
      ["warn-fg", "warn-bg"],
      ["neutral-fg", "neutral-bg"],
      ["danger", "ivory"],
      ["white", "promo"]
    ],
    "non-text": [
      ["green", "ivory"],
      ["green", "paper"],
      ["green", "sand"],
      ["green", "white"],
      ["gold", "charcoal"],
      ["gold", "green-900"]
    ]
  },
  "font": {
    "family": {
      "display": "'Gilda Display', Georgia, 'Times New Roman', serif",
      "sans": "'DM Sans', ui-sans-serif, system-ui, -apple-system, 'Segoe UI', Roboto, sans-serif"
