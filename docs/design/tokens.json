    "tab": "47.5rem",
    "desk": "62.5rem"
  },
  "shadow": {
    "xs": "0 1px 2px rgb(25 45 35 / 0.06)",
    "sm": "0 2px 8px rgb(25 45 35 / 0.08)",
    "md": "0 15px 40px rgb(28 48 38 / 0.09)",
    "lg": "0 24px 70px rgb(25 45 35 / 0.12)",
    "fab": "0 13px 35px rgb(16 67 40 / 0.3)"
  },
  "motion": {
    "duration": {
      "instant": "100ms",
      "fast": "200ms",
      "base": "250ms",
      "slow": "450ms",
      "slower": "800ms",
      "reveal": "1100ms"
    },
    "easing": {
      "standard": "cubic-bezier(0.2, 0, 0, 1)",
      "out-soft": "cubic-bezier(0.22, 1, 0.36, 1)",
      "in-out-soft": "cubic-bezier(0.65, 0, 0.35, 1)",
      "in": "cubic-bezier(0.4, 0, 1, 1)",
      "mockup": "ease"
    },
    "hero-autoplay-ms": 5500,
    "hover-lift": "-2px",
    "card-lift": "-5px",
    "image-zoom": 1.035
  },
  "z": {
    "whatsapp-fab": 70,
    "header": 80,
    "mobile-menu": 90,
    "overlay": 200,
    "toast": 300,
    "skip-link": 1000
  }
}
