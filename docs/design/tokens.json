      "wordmark-sub": "0.58rem"
    },
    "line-height": {
      "heading": 1.05,
      "tight": 1.1,
      "snug": 1.25,
      "body": 1.55,
      "normal": 1.6
    },
    "letter-spacing": {
      "display": "-0.045em",
      "h2": "-0.035em",
      "kicker": "0.16em",
      "label": "0.12em",
      "wordmark": "0.24em"
    }
  },
  "radius": {
    "xs": "0.5rem",
    "sm": "0.75rem",
    "md": "1.125rem",
    "lg": "1.5rem",
    "xl": "2rem",
    "pill": "999px"
  },
  "spacing": {
    "base-unit": "0.25rem",
    "scale": {
      "0": "0",
      "1": "0.25rem",
      "2": "0.5rem",
      "3": "0.75rem",
      "4": "1rem",
      "5": "1.25rem",
      "6": "1.5rem",
      "8": "2rem",
      "10": "2.5rem",
