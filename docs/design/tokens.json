{
  "$schema-note": "Design tokens v0.1 for Hotel Bambú Plaza. Source for Tailwind CSS v4 @theme (apps/web). Keys map to CSS variables: color.bamboo.700 -> --color-bamboo-700, semantic.* -> shadcn/ui variables. Pending hotel approval.",
  "color": {
    "bamboo": {
      "100": "#DDEEE3",
      "300": "#8EC3A4",
      "500": "#3B8F69",
      "600": "#267A58",
      "700": "#1D6247",
      "800": "#174C39",
      "900": "#12392B"
    },
    "cane": {
      "500": "#C9A55C",
      "700": "#8A6A2B"
    },
    "sand": {
      "50": "#F7F3EA",
      "100": "#EEE7D8",
      "200": "#D9CFBA"
    },
    "earth": {
      "600": "#A8582F"
    },
    "ink": {
      "600": "#56605A",
      "900": "#1A1F1C"
    },
    "error": {
      "600": "#B3261E"
    },
    "white": "#FFFFFF",
    "whatsapp": "#25D366"
  },
  "semantic": {
    "background": "{color.sand.50}",
    "foreground": "{color.ink.900}",
    "card": "{color.white}",
    "card-foreground": "{color.ink.900}",
    "popover": "{color.white}",
    "popover-foreground": "{color.ink.900}",
    "primary": "{color.bamboo.700}",
    "primary-foreground": "{color.white}",
    "primary-hover": "{color.bamboo.600}",
    "secondary": "{color.sand.100}",
    "secondary-foreground": "{color.bamboo.900}",
    "muted": "{color.sand.100}",
    "muted-foreground": "{color.ink.600}",
    "accent": "{color.bamboo.100}",
    "accent-foreground": "{color.bamboo.900}",
    "accent-decorative": "{color.cane.500}",
    "destructive": "{color.error.600}",
    "destructive-foreground": "{color.white}",
    "border": "{color.sand.200}",
    "input": "{color.sand.200}",
    "ring": "{color.bamboo.600}",
    "surface-dark": "{color.bamboo.900}",
    "on-surface-dark": "{color.sand.50}",
    "on-surface-dark-muted": "{color.bamboo.300}",
    "promo": "{color.earth.600}",
    "promo-foreground": "{color.white}",
    "whatsapp": "{color.whatsapp}",
    "whatsapp-foreground": "{color.ink.900}"
  },
  "font": {
    "family": {
      "display": "'Fraunces', ui-serif, Georgia, 'Times New Roman', serif",
      "sans": "'Manrope', ui-sans-serif, system-ui, -apple-system, 'Segoe UI', Roboto, sans-serif"
    },
    "weight": {
      "regular": 400,
      "medium": 500,
      "semibold": 600
    },
    "display-settings": {
      "font-variation-settings": "'SOFT' 50",
      "font-optical-sizing": "auto"
    },
    "size": {
      "xs": "0.8125rem",
      "sm": "0.875rem",
      "base": "clamp(1rem, 0.96rem + 0.2vw, 1.0625rem)",
      "lg": "clamp(1.125rem, 1.06rem + 0.3vw, 1.25rem)",
      "xl": "clamp(1.25rem, 1.12rem + 0.6vw, 1.5rem)",
      "2xl": "clamp(1.5rem, 1.28rem + 1vw, 2rem)",
      "3xl": "clamp(1.875rem, 1.5rem + 1.8vw, 2.75rem)",
      "4xl": "clamp(2.25rem, 1.6rem + 3vw, 3.75rem)",
      "5xl": "clamp(2.75rem, 1.8rem + 4.5vw, 5rem)"
    },
    "line-height": {
      "tight": 1.1,
      "snug": 1.25,
      "normal": 1.6
    },
    "letter-spacing": {
      "display": "-0.01em",
      "kicker": "0.24em"
    }
  },
  "radius": {
    "xs": "0.25rem",
    "sm": "0.5rem",
    "md": "0.75rem",
    "lg": "1rem",
    "xl": "1.5rem",
    "pill": "9999px"
  },
  "spacing": {
    "base-unit": "0.25rem",
    "scale": {
      "0": "0",
      "1": "0.25rem",
      "2": "0.5rem",
      "3": "0.75rem",
      "4": "1rem",
      "5": "1.25rem",
      "6": "1.5rem",
      "8": "2rem",
      "10": "2.5rem",
      "12": "3rem",
      "16": "4rem",
      "20": "5rem",
      "24": "6rem",
      "32": "8rem"
    },
    "section-y": "clamp(4rem, 2.5rem + 6vw, 8rem)",
    "container-max": "80rem",
    "gutter": "clamp(1rem, 0.5rem + 2.5vw, 2.5rem)"
  },
  "shadow": {
    "xs": "0 1px 2px rgb(18 57 43 / 0.06)",
    "sm": "0 2px 8px rgb(18 57 43 / 0.08)",
    "md": "0 8px 24px rgb(18 57 43 / 0.10)",
    "lg": "0 16px 48px rgb(18 57 43 / 0.14)"
  },
  "motion": {
    "duration": {
      "instant": "100ms",
      "fast": "180ms",
      "base": "320ms",
      "slow": "600ms",
      "slower": "900ms",
      "reveal": "1100ms"
    },
    "easing": {
      "standard": "cubic-bezier(0.2, 0, 0, 1)",
      "out-soft": "cubic-bezier(0.22, 1, 0.36, 1)",
      "in-out-soft": "cubic-bezier(0.65, 0, 0.35, 1)",
      "in": "cubic-bezier(0.4, 0, 1, 1)"
    },
    "gsap-easing": {
      "out-soft": "power3.out",
      "in-out-soft": "power2.inOut",
      "reveal": "expo.out"
    },
    "stagger": {
      "tight": "0.04s",
      "base": "0.08s"
    },
    "distance": {
      "reveal-y": "1.5rem"
    }
  },
  "z": {
    "header": 40,
    "whatsapp-fab": 45,
    "overlay": 50,
    "toast": 60
  }
}
