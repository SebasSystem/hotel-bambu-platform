# Hotel Bambú Plaza — environment variables (copy to `.env` at the repo root; never commit `.env`).
# Docker Compose, apps/api (Nest + Prisma) and apps/web (next.config.ts) all read this root file.
# Values below are LOCAL DEVELOPMENT defaults only. Production secrets come from the host/secret manager.

# ---------------------------------------------------------------------------
# PostgreSQL (docker-compose.yml service `postgres`)
# ---------------------------------------------------------------------------
POSTGRES_USER=hotel
POSTGRES_PASSWORD=change-me-local-only
POSTGRES_DB=hotel_bambu
# Host port published by Docker (container always listens on 5432).
POSTGRES_PORT=5432

# ---------------------------------------------------------------------------
# Object storage, S3-compatible (docker-compose.yml service `storage`, RustFS; see ADR 0005)
# ---------------------------------------------------------------------------
S3_ACCESS_KEY=hotel-local-access
S3_SECRET_KEY=change-me-local-only-secret
# Host ports published by Docker: S3 API and web console.
S3_PORT=9000
S3_CONSOLE_PORT=9001
# Endpoint the API uses to reach the bucket and the public base URL used in media links.
S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_BUCKET=hotel-media
S3_PUBLIC_BASE_URL=http://localhost:9000/hotel-media
# true for MinIO/RustFS-style path URLs (http://host/bucket/key).
S3_FORCE_PATH_STYLE=true

# ---------------------------------------------------------------------------
# API (apps/api) — validated at startup by apps/api/src/config/env.ts
# ---------------------------------------------------------------------------
NODE_ENV=development
API_HOST=0.0.0.0
API_PORT=4000
# fatal | error | warn | info | debug | trace
LOG_LEVEL=info
# Prisma 7 + pg adapter connection string (must match the POSTGRES_* values above).
DATABASE_URL=postgresql://hotel:change-me-local-only@localhost:5432/hotel_bambu?schema=public

# ---------------------------------------------------------------------------
# Web (apps/web)
# ---------------------------------------------------------------------------
# Server-side URL Next.js uses to proxy /api/v1/* and fetch data (internal network in production).
API_INTERNAL_URL=http://localhost:4000
# Public canonical origin of the site (SEO, absolute URLs). Set the real domain in production.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
