{
  "name": "hotel-bambu-platform",
  "private": true,
  "description": "Public website and admin panel for Hotel Bambú Plaza",
  "packageManager": "pnpm@11.24.0",
  "engines": {
    "node": ">=24.11.0"
  },
  "type": "module",
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "e2e": "docker compose --profile e2e run --rm e2e",
    "lighthouse": "docker compose --profile e2e run --rm -e E2E_COMMAND=lighthouse e2e",
    "db:up": "docker compose up -d",
    "db:down": "docker compose down",
    "prod:config": "docker compose -f docker-compose.prod.yml --env-file deploy/.env.production config --quiet",
    "prod:build": "docker compose -f docker-compose.prod.yml --env-file deploy/.env.production build",
    "prod:up": "docker compose -f docker-compose.prod.yml --env-file deploy/.env.production up -d --wait",
    "prod:down": "docker compose -f docker-compose.prod.yml --env-file deploy/.env.production down",
    "prod:ps": "docker compose -f docker-compose.prod.yml --env-file deploy/.env.production ps -a",
    "prod:logs": "docker compose -f docker-compose.prod.yml --env-file deploy/.env.production logs -f --tail=200",
    "prod:backup": "docker compose -f docker-compose.prod.yml --env-file deploy/.env.production exec backup backup.sh"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "eslint": "^10.14.0",
    "eslint-config-prettier": "^10.1.8",
    "globals": "^17.14.0",
    "prettier": "^3.9.10",
    "turbo": "^2.11.10",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.72.1"
  }
}
