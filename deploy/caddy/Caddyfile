# Primary ingress (profile `caddy`): Cloudflare (proxied DNS, SSL "Full (strict)") -> Caddy :443
# with a Cloudflare Origin CA certificate -> web:3000. No ACME: the origin certificate is mounted
# at /certs (ORIGIN_CERT_DIR). The host firewall admits 443 from Cloudflare only
# (deploy/scripts/ufw-cloudflare.sh). Guide: deploy/README.md.
{
	# Certificates are provided; never try ACME or open :80 redirects (Cloudflare does that).
	auto_https off
	admin off
	servers {
		# Cloudflare ranges (https://www.cloudflare.com/ips/, fetched 2026-11-04). Refresh when
		# Cloudflare publishes changes; the same list feeds the firewall script.
		trusted_proxies static 173.245.48.0/20 103.21.244.0/22 103.22.200.0/22 103.31.4.0/22 141.101.64.0/18 108.162.192.0/18 190.93.240.0/20 188.114.96.0/20 197.234.240.0/22 198.41.128.0/17 162.158.0.0/15 104.16.0.0/13 104.24.0.0/14 172.64.0.0/13 131.0.72.0/22 2400:cb00::/32 2606:4700::/32 2803:f800::/32 2405:b500::/32 2405:8100::/32 2a06:98c0::/29 2c0f:f248::/32
		trusted_proxies_strict
		client_ip_headers CF-Connecting-IP X-Forwarded-For
	}
	log {
		output stdout
		format json
	}
}

(origin_tls) {
	tls /certs/origin.pem /certs/origin.key
	# Optional, recommended: Cloudflare Authenticated Origin Pulls (SSL/TLS > Origin Server).
	# Download the Cloudflare origin-pull CA to /certs/origin-pull-ca.pem, then uncomment:
	# tls /certs/origin.pem /certs/origin.key {
	# 	client_auth {
	# 		mode require_and_verify
	# 		trust_pool file /certs/origin-pull-ca.pem
	# 	}
	# }
}

# Canonical host: the whole site (public pages, /admin, /api/v1/* proxied by Next.js).
https://{$SITE_HOST}:443 {
	import origin_tls
	request_body {
		max_size 20MB
	}
	header -Server
	# Request headers pass through unchanged, CF-Connecting-IP included (read by the API when
	# TRUST_CLOUDFLARE=true; Next.js forwards it on the /api/v1 rewrite).
	reverse_proxy web:3000
}

# Secondary host (apex or www): permanent redirect to the canonical host.
https://{$SITE_REDIRECT_HOST}:443 {
	import origin_tls
	header -Server
	redir https://{$SITE_HOST}{uri} permanent
}

