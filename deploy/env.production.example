# Production environment template for docker-compose.prod.yml (guide: deploy/README.md).
# Copy it on the VPS to deploy/.env.production (git-ignored), fill every <placeholder>, then
#   chmod 600 deploy/.env.production
# Never commit the real file. Generate secrets with: openssl rand -hex 32
# Variable reference: docs/configuration.md.

# ── Compose ────────────────────────────────────────────────────────────────────────────────────
COMPOSE_PROJECT_NAME=hotel-bambu-prod
# caddy = primary ingress (443 + Cloudflare Origin CA cert), backup = daily pg_dump.
# Alternative ingress: replace `caddy` with `tunnel` (Cloudflare Tunnel). Add `storage` only for
# self-hosted RustFS instead of Cloudflare R2.
COMPOSE_PROFILES=caddy,backup
IMAGE_TAG=latest
TZ=America/Bogota

# ── Public site ────────────────────────────────────────────────────────────────────────────────
# Canonical origin (sitemap, canonical URLs, Open Graph). https enables upgrade-insecure-requests.
SITE_URL=https://www.<your-domain>
# Browser origins allowed to send unsafe requests (CSRF Origin check): every hostname that serves
# the site, comma separated.
WEB_ORIGINS=https://www.<your-domain>,https://<your-domain>
# Keep false until go-live (deploy/README.md checklist). false = noindex + robots Disallow.
SITE_INDEXABLE=false
# true only after the hotel and its lawyer approved the legal texts (docs/legal-checklist.md).
LEGAL_APPROVED=false
LEGAL_EFFECTIVE_DATE=

# ── Secrets (openssl rand -hex 32; each value different) ──────────────────────────────────────
SESSION_SECRET=<64-hex-chars>
REVALIDATE_SECRET=<64-hex-chars>

# ── Ingress: Caddy (profile caddy) ────────────────────────────────────────────────────────────
# Canonical host (same as SITE_URL) and the host that redirects to it.
SITE_HOST=www.<your-domain>
SITE_REDIRECT_HOST=<your-domain>
# Host folder with origin.pem + origin.key (Cloudflare Origin CA), chmod 600, owned by root.
ORIGIN_CERT_DIR=/etc/hotel-bambu/certs
# Only with self-hosted storage and the media block enabled in deploy/caddy/Caddyfile.
MEDIA_HOST=

# ── Proxy chain ────────────────────────────────────────────────────────────────────────────────
# CF-Connecting-IP is trustworthy only because the origin is reachable through Cloudflare alone:
# Caddy + deploy/scripts/ufw-cloudflare.sh (443 from Cloudflare ranges only), or the tunnel.
# The API identifies clients by that header, so TRUST_PROXY stays false (see docs/configuration.md).
TRUST_CLOUDFLARE=true
TRUST_PROXY=false
COOKIE_SECURE=true
LOG_LEVEL=info

# ── PostgreSQL (internal network only) ────────────────────────────────────────────────────────
POSTGRES_USER=hotel
# Hex only: it is embedded in DATABASE_URL.
POSTGRES_PASSWORD=<64-hex-chars>
POSTGRES_DB=hotel_bambu

# ── Object storage ─────────────────────────────────────────────────────────────────────────────
# Recommended: Cloudflare R2 bucket with a custom public domain (media.<your-domain>).
#   S3_ENDPOINT=https://<account-id>.r2.cloudflarestorage.com
#   S3_REGION=auto
#   S3_PUBLIC_URL=https://media.<your-domain>          (bucket root, no bucket name in the path)
# Self-hosted RustFS (add `storage` to COMPOSE_PROFILES):
#   S3_ENDPOINT=http://storage:9000
#   S3_REGION=us-east-1
#   S3_PUBLIC_URL=https://media.<your-domain>/hotel-media   (tunnel hostname -> http://storage:9000)
S3_ENDPOINT=https://<account-id>.r2.cloudflarestorage.com
S3_REGION=auto
S3_BUCKET=hotel-media
# R2 API token scoped to this bucket only (Object Read & Write).
S3_ACCESS_KEY=<access-key-id>
S3_SECRET_KEY=<secret-access-key>
S3_FORCE_PATH_STYLE=true
S3_PUBLIC_URL=https://media.<your-domain>

# ── Cloudflare Tunnel (profile tunnel, alternative to caddy) ─────────────────────────────────────────────────────────
# Zero Trust > Networks > Tunnels > your tunnel > Docker: the value after --token.
TUNNEL_TOKEN=<tunnel-token>

# ── Backups (profile backup) ──────────────────────────────────────────────────────────────────
# Host folder for dumps: outside the repository, readable by root only (chmod 700).
BACKUP_HOST_DIR=/var/backups/hotel-bambu
BACKUP_HOUR=3
BACKUP_RETENTION_DAYS=14
# Off-site copy (strongly recommended): a separate private R2 bucket with its own token.
BACKUP_S3_URI=
BACKUP_S3_ENDPOINT=
BACKUP_S3_REGION=auto
BACKUP_S3_ACCESS_KEY=
BACKUP_S3_SECRET_KEY=
# true mirrors the media bucket into BACKUP_HOST_DIR/media on every run.
BACKUP_MEDIA=false
