{
  "name": "@hotel-bambu/api",
  "version": "0.0.0",
  "private": true,
  "description": "NestJS (Fastify) REST API for Hotel Bambú Plaza",
  "type": "module",
  "scripts": {
    "prebuild": "prisma generate",
    "build": "nest build",
    "dev": "prisma generate && nest start --watch",
    "start": "node dist/main.js",
    "lint": "eslint .",
    "pretypecheck": "prisma generate",
    "typecheck": "tsc --noEmit",
    "pretest": "prisma generate",
    "test": "vitest run",
    "prisma": "prisma",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:migrate:deploy": "prisma migrate deploy",
    "db:seed:base": "tsx src/scripts/seed-base.ts",
    "db:seed:demo": "tsx src/scripts/seed-demo.ts",
    "admin:create": "tsx src/scripts/admin-create.ts",
    "media:import": "tsx src/scripts/media-import.ts"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1161.0",
    "@fastify/helmet": "^13.2.0",
    "@hotel-bambu/shared": "workspace:*",
    "@nestjs/common": "~12.3.2",
    "@nestjs/config": "~12.0.1",
    "@nestjs/core": "~12.3.2",
    "@nestjs/platform-fastify": "~12.3.2",
    "@node-rs/argon2": "^2.2.2",
    "@prisma/adapter-pg": "^7.10.1",
    "@prisma/client": "^7.10.1",
    "file-type": "^22.3.0",
    "nestjs-pino": "^5.3.1",
    "pg": "^8.23.1",
    "pino": "^10.4.0",
    "pino-http": "^11.0.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "sharp": "^0.35.5",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@nestjs/cli": "^12.0.11",
    "@nestjs/testing": "~12.3.2",
    "@swc/core": "^1.16.21",
    "@types/node": "^24.0.0",
    "pino-pretty": "^13.2.0",
    "prisma": "^7.10.1",
    "tsx": "^4.23.15",
    "typescript": "~6.0.3",
    "unplugin-swc": "^2.0.0",
    "vitest": "^5.1.0"
  }
}
