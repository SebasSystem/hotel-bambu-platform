// Prisma 7: connection URL lives in prisma.config.ts; the client uses the pg driver adapter.
// Domain models arrive in Phase 2 (task T3, requirement section 14).

generator client {
  provider            = "prisma-client"
  output              = "../src/generated/prisma"
  runtime             = "nodejs"
  moduleFormat        = "esm"
  importFileExtension = "js"
}

datasource db {
  provider = "postgresql"
}
